# ─────────────────────────────────────────────────────────────
# Example env file. Copy to backend/.env and fill in real values.
# backend/.env is gitignored — NEVER commit real secrets.
#
# The web app's primary credential source is the Settings UI (stored in DB).
# The values here are only an optional fallback / used by the auto_run.py CLI.
# Everything else (storage path, CORS, server host/port) comes from defaults
# in backend/app/config.py.
# ─────────────────────────────────────────────────────────────

# VBEE TTS (Official API) — primary credential set
VBEE_APP_ID=your_app_id_here
VBEE_BEARER_TOKEN=your_bearer_token_here

# VBEE fallback set — auto_run.py tries this if the primary fails (optional)
VBEE_APP_ID_2=
VBEE_BEARER_TOKEN_2=

# OpenAI — only used by the auto_run.py CLI spell-check step (optional)
OPENAI_API_KEY=

# Optional: point at MySQL instead of the default SQLite
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3307/truyenfull_db
